# Server port (OAuth + MCP on same port)
PORT=8081

# Public base URL (used in OAuth metadata discovery)
BASE_URL=https://localhost:8081

# HMAC secret for signing tokens (hex-encoded, 32+ bytes)
# If omitted, a random secret is generated (tokens won't survive restarts)
# Generate with: openssl rand -hex 32
# OAUTH_SECRET=

# Dev mode: skip OAuth, use credentials from env directly
# DEV_MODE=true
# KUVERA_USERNAME=
# KUVERA_PASSWORD=
# STOCKAL_USERNAME=
# STOCKAL_PASSWORD=
